# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

# region = "fra1"                          # Frankfurt (default)
# region = "nyc3"                          # New York
# region = "sgp1"                          # Singapore

# ssh_public_key_path  = "~/.ssh/do_cyber.pub"
# ssh_private_key_path = "~/.ssh/do_cyber"

# Restrict SSH to your IP (recommended for production).
# Find your IP: curl -s ifconfig.me
# ssh_allowed_ips = ["YOUR_IP/32"]
