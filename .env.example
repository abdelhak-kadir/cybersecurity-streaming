# =============================================================
#  .env.example — configuration template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# =============================================================

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKER=kafka:29092

# ── Cassandra ──────────────────────────────────────────────────
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=CyberCluster
CASSANDRA_DC=datacenter1
HEAP_NEWSIZE=128M
MAX_HEAP_SIZE=512M

# ── HBase ──────────────────────────────────────────────────────
HBASE_HOST=hbase
HBASE_PORT=9090

# ── Spark workers ──────────────────────────────────────────────
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ── Kafka producer ─────────────────────────────────────────────
CSV_FILE=/data/cybersecurity_threat_detection_logs.csv
# Events per second sent to Kafka (0.1 = 10/s, 0.01 = 100/s)
SEND_DELAY=0.1
# 0 = replay the full CSV indefinitely
MAX_MESSAGES=0

# ── Spark Structured Streaming ─────────────────────────────────
CHECKPOINT_BASE=/tmp/spark-checkpoints-v3
MAX_THREATS_PER_BATCH=2000
# Seconds to look back when correlating multi-step attacks
CORRELATION_WINDOW_SECONDS=600

# ── Serving layer ──────────────────────────────────────────────
ML_SUMMARY_PATH=/data/ml_summary.json

# ── Grafana ────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin

# ── Grafana alerting — SendGrid ────────────────────────────────
# Alerts are sent from alert@project-demo.tech via SendGrid.
# 1. Sign up at sendgrid.com (free tier = 100 emails/day)
# 2. Settings → Sender Authentication → verify project-demo.tech
# 3. Settings → API Keys → create key with "Mail Send" permission
ALERT_EMAIL=you@example.com        # recipient (where alerts land)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ── Domain & HTTPS (Caddy — Droplet 3 only) ────────────────────
# Point both subdomains at the serve droplet IP before deploying.
DOMAIN=your-domain.com
GRAFANA_SUBDOMAIN=grafana.your-domain.com
ACME_EMAIL=you@example.com
# Set to true to also serve FastAPI at api.<DOMAIN> over HTTPS
EXPOSE_API=false
API_SUBDOMAIN=api.your-domain.com

# ── Cloud deployment (DigitalOcean) ────────────────────────────
# Required only for: make tf-apply / make deploy-all
# Get a token at: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=your_token_here

# Terraform variables — TF_VAR_* is the standard way to pass
# values into Terraform without a .tfvars file
TF_VAR_region=fra1
TF_VAR_ssh_public_key_path=~/.ssh/do_cyber.pub
TF_VAR_ssh_private_key_path=~/.ssh/do_cyber
TF_VAR_domain=your-domain.com
TF_VAR_grafana_subdomain=grafana
TF_VAR_api_subdomain=api
TF_VAR_expose_api=false

# Ansible — used by generate_inventory.sh to write inventory.ini
ANSIBLE_SSH_KEY=~/.ssh/do_cyber
